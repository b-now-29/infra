# b-now-29/app (기존 deploy/Caddyfile에서 옮김)
{$DOMAIN} {
	encode zstd gzip

	# /java-quiz → /java-quiz/ 로 이동 (끝에 / 없이 접속해도 열리게)
	redir /java-quiz /java-quiz/ 308

	# /java-quiz/* → 서버의 ~/app/static/java-quiz/* (경로를 그대로 사용)
	handle /java-quiz/* {
		root * /srv/static
		file_server
	}

	# 나머지 전부 → Spring Boot
	handle {
		reverse_proxy app:8080 {
			# app이 응답하지 않으면 최대 30초까지 0.5초 간격으로 재시도
			lb_try_duration 30s
			lb_try_interval 500ms

			# /actuator/health로 app 상태를 계속 확인
			health_uri /actuator/health
			health_interval 5s
		}
	}
}

# b-now-29/zipgwan 스타디움 서버 (WebSocket 포함). 서버는 zipgwan의 I02에서 올라간다. 그 전에는 502가 정상이다.
stadium.{$DOMAIN} {
	encode zstd gzip

	# 개인정보처리방침(zipgwan I04). 이 저장소의 static/stadium/privacy.html. 스타디움 서버가 꺼져 있어도 열린다.
	handle /privacy {
		root * /srv/stadium
		rewrite * /privacy.html
		file_server
	}

	reverse_proxy stadium:8080 {
		# 배포로 재시작하는 동안 최대 30초까지 0.5초 간격으로 재시도
		lb_try_duration 30s
		lb_try_interval 500ms
		# 상태 확인(health_uri)은 스타디움 서버에 actuator가 생기면 추가한다.
	}
}
